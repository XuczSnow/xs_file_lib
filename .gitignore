# ==========================
# Python
# ==========================

__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
venv/
env/
.venv/

# 打包文件
build/
dist/
*.egg-info/

# ==========================
# IDE
# ==========================

.vscode/
.idea/
*.iml

# ==========================
# 系统文件
# ==========================

.DS_Store
Thumbs.db
desktop.ini

# ==========================
# 日志
# ==========================

*.log
logs/

# ==========================
# 上传文件
# ==========================

uploads/*
!uploads/.gitkeep

# 配置（人手工可改的轻量设置）
config/*
!config/.gitkeep

# 业务数据（用户、密钥、链接、访问日志；程序写入，不入库，备份必保）
data/*
!data/.gitkeep

# 回收站
recycle_bin/*
!recycle_bin/.gitkeep

# ==========================
# 数据库（未来扩展）
# ==========================

*.db
*.sqlite
*.sqlite3

# ==========================
# 缓存 / 运行产物（可再生产，删了自动重建，无需备份）
# ==========================

# zip 打包缓存 + 缩略图缓存（旧 .thumbs/ 已并入 cache/thumbs/ 并自动清理）
cache/

# 本地临时文件
*.tmp
*.bak
*.swp
.tmp_*

# ==========================
# 测试
# ==========================

.pytest_cache/
.coverage
htmlcov/

# ==========================
# 其他
# ==========================

# Node（如未来引入前端构建）
node_modules/

# AI 助手工作区（会话记录、上传的参考文件）
.agnes/
